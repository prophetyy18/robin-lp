# Robinhood LP — environment variable names only.
#
# This file lists the names the framework expects to read at runtime.
# Real values must be set in the shell or in a real `.env` file (which is
# git-ignored). Never commit values for these variables.

# RPC URLs referenced by tests/fixtures/config/*.toml.
# Each ChainConfig names exactly one of these via `rpc_url_env`.
ETH_MAINNET_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_CHAIN_RPC_URL=
