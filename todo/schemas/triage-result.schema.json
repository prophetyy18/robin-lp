{
  "$id": "https://robinhood-lp.local/schemas/triage-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "issue_commit",
    "classification",
    "summary",
    "evidence",
    "recommended_action"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "issue_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "classification": {
      "enum": [
        "IMPLEMENTATION_DEFECT",
        "CONTRACT_MISMATCH",
        "SPEC_DEFECT",
        "OWNER_DECISION_REQUIRED",
        "EXTERNAL_BLOCKED"
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string"},
    "owner_question": {"type": ["string", "null"]}
  }
}
