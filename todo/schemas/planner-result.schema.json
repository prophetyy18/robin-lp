{
  "$id": "https://robinhood-lp.local/schemas/planner-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "outcome", "summary", "rationale", "unresolved_questions"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "outcome": {
      "enum": ["PLAN_READY", "NO_CHANGE_REQUIRED", "OWNER_DECISION_REQUIRED", "BLOCKED", "CONTINUATION_REQUIRED"]
    },
    "summary": {"type": "string"},
    "rationale": {"type": "string"},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "continuation": {
      "description": "Required only when outcome is CONTINUATION_REQUIRED; describes why the planning paused and what remains.",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "completed_work", "remaining_work", "next_actions", "changed_paths"],
      "properties": {
        "reason": {"const": "TURN_BUDGET"},
        "completed_work": {"type": "array", "items": {"type": "string"}},
        "remaining_work": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "changed_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "CONTINUATION_REQUIRED"}}},
      "then": {"required": ["continuation"]}
    }
  ]
}
